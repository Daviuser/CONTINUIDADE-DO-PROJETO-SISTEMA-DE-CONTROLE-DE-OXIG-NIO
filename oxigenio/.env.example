# Neon: use o endereço POOLED (host com "-pooler") para a aplicação
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/oxigenio?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon: endereço DIRETO, usado apenas por migrações
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/oxigenio?sslmode=require"
# Senha inicial do administrador (usada só pelo seed; troque no primeiro acesso)
SEED_ADMIN_EMAIL="admin@exemplo.invalid"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
# Duração da sessão por inatividade, em minutos
SESSION_IDLE_MINUTES="30"

# Foto do recibo: Vercel Blob em modo PRIVADO. Na Vercel o acesso é injetado ao conectar o store ao projeto.
# Em desenvolvimento local, copie o valor de BLOB_READ_WRITE_TOKEN do painel (vercel env pull).
BLOB_READ_WRITE_TOKEN=""
