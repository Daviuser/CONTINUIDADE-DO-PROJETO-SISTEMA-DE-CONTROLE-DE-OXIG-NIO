generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERADOR
  CONSULTA
}

enum CylinderSize {
  P
  M
  G
}

enum MovementStatus {
  RASCUNHO
  CONFIRMADA
  ESTORNADA
}

enum RecordStatus {
  ATIVO
  INATIVO
}

enum StockCondition {
  CHEIO
  VAZIO
  INDISPONIVEL
}
enum StockOperation {
  ENTRADA_INICIAL
  ABASTECIMENTO
  ENTREGA_DOMICILIAR
  RECOLHIMENTO_DOMICILIAR
  ENVIO_FORNECEDOR
  RETORNO_FORNECEDOR
  BAIXA_INDISPONIVEL
  RETORNO_DISPONIVEL
}
enum FlowmeterLocation {
  HOSPITAL
  DOMICILIO
}

enum FlowmeterOperation {
  ENTRADA
  ENVIO_DOMICILIO
  RETORNO_DOMICILIO
  BAIXA
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  jobTitle    String?
  passwordHash String
  role        Role     @default(CONSULTA)
  active      Boolean  @default(true)
  failedLogins Int     @default(0)
  lockedUntil DateTime?
  createdAt   DateTime @default(now())
  sessions    Session[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  @@index([userId])
}

// HOSPITAL, DOMICILIO e TRANSPORTE (exibido como "Com o fornecedor")
model Location {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  active    Boolean @default(true)
  balances  StockBalance[]
  movementsFrom StockMovement[] @relation("MovFrom")
  movementsTo   StockMovement[] @relation("MovTo")
}

model CylinderType {
  id    String       @id @default(cuid())
  size  CylinderSize @unique
  label String
  capacityLiters Decimal? @db.Decimal(8,2)
  balances  StockBalance[]
  movements StockMovement[]
}

// Saldo por quantidade (tamanho x local x estado). Só muda dentro de transação ao registrar movimentação.
model StockBalance {
  locationId     String
  cylinderTypeId String
  condition      StockCondition
  quantity       Int @default(0)
  location       Location     @relation(fields: [locationId], references: [id])
  cylinderType   CylinderType @relation(fields: [cylinderTypeId], references: [id])
  @@id([locationId, cylinderTypeId, condition])
}

// Livro-razão: registros confirmados nunca são apagados; correção = estorno com justificativa.
model StockMovement {
  id             String         @id @default(cuid())
  operation      StockOperation
  status         MovementStatus @default(CONFIRMADA)
  cylinderTypeId String
  cylinderType   CylinderType   @relation(fields: [cylinderTypeId], references: [id])
  quantity       Int
  fromLocationId String?
  fromLocation   Location?      @relation("MovFrom", fields: [fromLocationId], references: [id])
  fromCondition  StockCondition?
  toLocationId   String?
  toLocation     Location?      @relation("MovTo", fields: [toLocationId], references: [id])
  toCondition    StockCondition?
  occurredAt     DateTime
  supplier       String?
  patientId      String?
  patient        Patient?       @relation(fields: [patientId], references: [id])
  responsibleName String
  notes          String?
  requestKey     String?        @unique
  reversalOfId   String?        @unique
  reversalReason String?
  createdById    String
  createdAt      DateTime       @default(now())
  @@index([operation, occurredAt])
  @@index([patientId, occurredAt])
}

model Patient {
  id            String       @id @default(cuid())
  fullName      String
  phone         String?
  address       String
  neighborhood  String?
  village       String?
  reference     String?
  cylinderSize  CylinderSize?
  cylinderQty   Int          @default(0)
  flowLpm       String?
  startDate     DateTime
  endDate       DateTime?
  status        RecordStatus @default(ATIVO)
  notes         String?
  responsibleId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  movements     StockMovement[]
  @@index([fullName])
  @@index([neighborhood])
  @@index([village])
}

model FlowmeterBalance {
  location FlowmeterLocation @id
  quantity Int @default(0)
}

model FlowmeterMovement {
  id              String             @id @default(cuid())
  operation       FlowmeterOperation
  status          MovementStatus     @default(CONFIRMADA)
  quantity        Int
  fromLocation    FlowmeterLocation?
  toLocation      FlowmeterLocation?
  occurredAt      DateTime
  responsibleName String
  notes           String?
  requestKey      String?            @unique
  reversalOfId    String?            @unique
  reversalReason  String?
  createdById     String
  createdAt       DateTime           @default(now())
  @@index([occurredAt])
}

model IssuedReport {
  id        String   @id @default(cuid())
  type      String
  params    Json
  issuedById String
  issuedAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  at        DateTime @default(now())
  @@index([entity, entityId])
  @@index([at])
}
